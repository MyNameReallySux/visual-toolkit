{
  "name": "@visual-toolkit/d3-helpers",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared scale contracts, CSS number utilities, SVG helpers, and D3 selection utilities",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-selection": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.10",
    "jsdom": "^24.1.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
