{
  "name": "@visual-toolkit/d3-band-scales",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed band-scale factories built on d3-scale — fixed-width and variable-width ordinal bands with gap, transform, and content-offset support",
  "license": "MIT",
  "author": "Chris Coppola",
  "homepage": "https://github.com/MyNameReallySux/visual-toolkit/tree/main/packages/d3-band-scales#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyNameReallySux/visual-toolkit.git",
    "directory": "packages/d3-band-scales"
  },
  "bugs": "https://github.com/MyNameReallySux/visual-toolkit/issues",
  "keywords": [
    "d3",
    "d3-scale",
    "band-scale",
    "ordinal-scale",
    "svg",
    "typescript",
    "visualization",
    "dataviz"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@visual-toolkit/d3-helpers": "workspace:*",
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
