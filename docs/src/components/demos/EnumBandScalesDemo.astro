<div class="demo-card">
  <div class="demo-card-header">makeEnumBandScale / makeFixedEnumBandScale</div>
  <div class="demo-card-body">
    <div class="controls" data-demo-controls="enum-band-scales"></div>
    <div class="svg-canvas" data-demo="enum-band-scales"></div>
  </div>
</div>

<script>
  import { makeSlider } from "../../demo-lib/section-helpers";
  import {
    renderEnumBandScales,
    type EnumBandScaleState,
  } from "../../demo-lib/examples/enum-band-scales";

  const FIXED_ITEM_KEYS = ["alpha", "beta", "gamma", "delta", "zeta"] as const;
  const DEFAULT_ENABLED = new Set(["alpha", "gamma", "delta"]);

  const controls = document.querySelector<HTMLElement>(
    '[data-demo-controls="enum-band-scales"]'
  );
  const mount = document.querySelector<HTMLElement>(
    '[data-demo="enum-band-scales"]'
  );

  if (controls && mount) {
    const state: EnumBandScaleState = { gap: 6, enabledKeys: new Set(DEFAULT_ENABLED) };
    const rerender = () => renderEnumBandScales(mount, state);

    makeSlider(controls, {
      labelText: "gap px",
      min: 0,
      max: 24,
      initial: state.gap,
      onChange: (v) => {
        state.gap = v;
        rerender();
      },
    });

    // Per-entry enable checkboxes for the fixed scale
    const checkRow = document.createElement("div");
    checkRow.className = "control-row";
    checkRow.style.flexWrap = "wrap";
    checkRow.style.gap = "0.5rem";
    const checkLbl = document.createElement("label");
    checkLbl.textContent = "enabled:";
    checkRow.appendChild(checkLbl);

    for (const key of FIXED_ITEM_KEYS) {
      const wrapper = document.createElement("label");
      wrapper.style.cssText =
        "display:flex;align-items:center;gap:4px;font-size:0.8rem;cursor:pointer";
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = state.enabledKeys.has(key);
      cb.addEventListener("change", () => {
        if (cb.checked) {
          state.enabledKeys.add(key);
        } else {
          state.enabledKeys.delete(key);
        }
        rerender();
      });
      wrapper.appendChild(cb);
      wrapper.appendChild(document.createTextNode(key));
      checkRow.appendChild(wrapper);
    }
    controls.appendChild(checkRow);

    rerender();
  }
</script>
