{
  "name": "visual-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A monorepo of typed D3 and SVG visualization utilities built on d3-scale",
  "license": "MIT",
  "author": "Chris Coppola",
  "homepage": "https://github.com/MyNameReallySux/visual-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyNameReallySux/visual-toolkit.git"
  },
  "bugs": "https://github.com/MyNameReallySux/visual-toolkit/issues",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:dev": "pnpm --filter visual-toolkit-docs dev",
    "docs:build": "pnpm --filter visual-toolkit-docs build",
    "docs:preview": "pnpm --filter visual-toolkit-docs preview"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.61.0"
  }
}
